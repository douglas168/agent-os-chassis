{
  "name": "agent-os-chassis",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "NODE_ENV=test vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@agentos/core",
    "db:migrate": "npm run db:migrate --workspace=@agentos/core",
    "db:migrate:test": "tsx --env-file=.env.local scripts/migrate-test-db.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "dotenv": "^17.4.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "8.2.2",
    "vitest": "^2.1.0"
  }
}
